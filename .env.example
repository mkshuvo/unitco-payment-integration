# Database
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=root
DATABASE_PASSWORD=password
DATABASE_NAME=unitco_payment_integration

# Unit API
UNIT_API_KEY=your_unit_api_key_here
UNIT_BASE_URL=https://api.s.unit.sh
UNIT_ACCOUNT_ID=your_unit_account_id_here

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ENCRYPTION_KEY=your_base64_encryption_key_here

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Payment Limits
PAYMENT_LIMIT_SINGLE=10000
PAYMENT_LIMIT_DAILY=50000

# Development
NODE_ENV=development
PORT=41873
ALLOW_PUBLIC_REGISTRATION=true

# Web App
NEXT_PUBLIC_API_URL=http://localhost:41873
